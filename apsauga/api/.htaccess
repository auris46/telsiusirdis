# Viešai pasiekiami tik šie failai; bibliotekos ir nustatymai – ne
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(status|expert|redeem|admin)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(status|expert|redeem|admin)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>
