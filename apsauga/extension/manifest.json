{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Apsauga",
  "description": "__MSG_extDesc__",
  "version": "1.3.0",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apsauga",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared/i18n.js",
      "shared/detector.js",
      "background.js"
    ]
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "webNavigation",
    "tabs",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/i18n.js",
        "shared/detector.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "clipguard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "apsauga@telsiusirdis",
      "strict_min_version": "128.0"
    }
  }
}
